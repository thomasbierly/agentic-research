#!/usr/bin/env bash
# ws: open (or return to) a Herdr workspace for a project, laid out for the kind of work.
#
#   ws [folder] [--layout research|writing|analysis|dev] [--label name] [--detect] [--gui]
#   ws --menu      regenerate the Workspaces submenu of the Omarchy menu
#   ws --new research|writing|analysis|dev [--name name]
#                  create a project (asks for the name if not given), add it to
#                  the menu and open it, in ~/Projects (the menu's New project is research)
#   ws --notebook [folder]   serve the project's marimo notebooks (analysis/); runs in the analysis tab
#   ws --open-notebook [folder] [file]   open a notebook window (the editor's right-click menu)
#
# Layouts (picked from the project's files unless --layout is given):
#   research  software, data analysis and paper in one repo (paper/_quarto.yml)
#             work: LazyVim | Claude   analysis: shell | marimo notebooks   paper: quarto preview
#             review: Hunk   git: lazygit
#   writing   Quarto book or manuscript (_quarto.yml)
#             write: LazyVim | Claude   review: Hunk   build: quarto preview
#   analysis  Python/R research project (pyproject.toml, notebooks, .R, renv.lock)
#             work: LazyVim | Claude   console: IPython | DuckDB   preview: quarto preview   review: Hunk
#   dev       software project (package.json, Dockerfile, compose, go.mod, Cargo.toml, ...)
#             code: LazyVim | Claude   run: shell   git: lazygit   review: Hunk   infra: lazydocker or shell
#
# If a workspace with the label already exists it is focused, not rebuilt, so the
# agent and its conversation survive. Run from any terminal or from inside Herdr.
# --gui (used by the Omarchy menu) also starts Herdr if needed and brings its window forward.
set -euo pipefail

dir="" layout="" label="" detect="" gui="" new="" name="" notebook="" open_notebook="" nbfile=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --layout) layout="${2:?}"; shift 2 ;;
    --label)  label="${2:?}"; shift 2 ;;
    --detect) detect=1; shift ;;
    --gui)    gui=1; shift ;;
    --menu)   menu=1; shift ;;
    --new)    new="${2:?}"; shift 2 ;;
    --name)   name="${2:?}"; shift 2 ;;
    --notebook) notebook=1; shift ;;
    --open-notebook) open_notebook=1; shift ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) if [[ -n "$open_notebook" && -n "$dir" ]]; then nbfile="$1"; else dir="$1"; fi; shift ;;
  esac
done

fail() {   # report an error in the terminal, or as a notification when run from the menu
  echo "ws: $*" >&2
  [[ -n "$gui" ]] && notify-send -u critical "Workspace" "$*" 2>/dev/null
  exit 1
}

# ---- ws --menu: Workspaces submenu for the Omarchy menu --------------------------
if [[ -n "${menu:-}" ]]; then
  MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
  ROOTS=("$HOME/Projects")
  self="$(realpath "$0")"
  block=$(
    printf '  // >>> ws: generated by `ws --menu` from %s; edits here are overwritten\n' "${ROOTS[*]}"
    printf '  "workspaces": {"icon":"","label":"Projects","aliases":["projects","ws","workspaces"],"description":"Open a project in Herdr"},\n'
    jq -cn --arg action "$self --gui --new research" \
      '{"workspaces.00-new": {icon: "", label: "New project…", description: "Code, data analysis and paper in one folder in ~/Projects", action: $action}}' \
      | sed 's/^{//; s/}$//; s/^/  /; s/$/,/'
    for root in "${ROOTS[@]}"; do
      for d in "$root"/*/; do
        [[ -d "$d" ]] || continue                            # empty root: the glob did not match
        d="${d%/}"; name="$(basename "$d")"
        [[ "$name" == _* ]] && continue                     # templates such as _template
        l=$("$self" "$d" --detect | sed 's/.*: //')
        case "$l" in research) icon="󰂓" ;; writing) icon="󰈙" ;; analysis) icon="󰄧" ;; *) icon="" ;; esac
        slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-*$//')
        jq -cn --arg id "workspaces.$slug" --arg icon "$icon" --arg label "$name" \
              --arg desc "${d/#$HOME/\~}" --arg action "$self --gui $(printf %q "$d")" \
              '{($id): {icon: $icon, label: $label, description: $desc, action: $action}}' | sed 's/^{//; s/}$//; s/^/  /; s/$/,/'
      done
    done
    jq -cn --arg action "$self --menu && notify-send Workspaces 'Project list updated'" \
      '{"workspaces.zz-refresh": {icon: "󰑐", label: "Refresh project list", action: $action}}' | sed 's/^{//; s/}$//; s/^/  /' 
    printf '  // <<< ws\n'
  )
  if [[ ! -f "$MENU" ]]; then   # Omarchy creates it at install; recreate it if it was removed
    mkdir -p "$(dirname "$MENU")"
    if [[ -f /usr/share/omarchy/config/omarchy/extensions/omarchy-menu.jsonc ]]; then
      cp /usr/share/omarchy/config/omarchy/extensions/omarchy-menu.jsonc "$MENU"
    else
      printf '{\n}\n' >"$MENU"
    fi
  fi
  python3 - "$MENU" "$block" <<'PY'
import re, sys
path, block = sys.argv[1], sys.argv[2]
s = open(path, encoding="utf-8").read()
s = re.sub(r"\n?  // >>> ws:.*?// <<< ws\n", "\n", s, flags=re.S)
i = s.rstrip().rfind("}")
body = s[:i].rstrip()
# entries already in the file need a comma before the generated block
if re.search(r'"\s*}\s*$', body) or re.search(r'}\s*$', body.split("{", 1)[1] if "{" in body else ""):
    if not body.endswith(","): body += ","
s = body + "\n" + block + "\n}\n"
open(path, "w", encoding="utf-8").write(s)
PY
  echo "Updated the Workspaces menu in $MENU"
  exit 0
fi

# ---- ws --new: create a project, add it to the menu, open it --------------------
if [[ -n "$new" ]]; then
  case "$new" in
    research|writing|analysis|dev) parent="$HOME/Projects" ;;
    *) fail "unknown project kind '$new' (research, writing, analysis or dev)" ;;
  esac
  if [[ -z "$name" ]]; then
    if [[ -n "$gui" ]]; then
      name=$(omarchy-menu-input "Name of the new project" --width 500) || exit 0   # Esc: cancelled
    elif [[ -t 0 ]]; then
      read -rp "Name of the new project: " name
    fi
  fi
  name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\+/-/g')
  [[ -n "$name" ]] || fail "no project name given"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "use letters, numbers, - _ or . in the name (got '$name')"
  dir="$parent/$name"
  [[ -e "$dir" ]] && fail "$dir already exists; open it from the Workspaces menu instead"
  [[ -n "$gui" ]] && notify-send "Workspace" "Creating $name…" 2>/dev/null

  mkdir -p "$dir"
  author=$(git config user.name 2>/dev/null || echo "")
  title=$(printf '%s' "$name" | tr '_-' '  ')
  case "$new" in
    research)
      # Python package name: lowercase letters, digits and _, starting with a letter
      pkg=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_' '_' | sed 's/_*$//; s/^\([0-9]\)/p\1/')
      ( cd "$dir" && uv init -q --lib --name "$pkg" ) || fail "uv init failed"
      ( cd "$dir" && uv add -q "marimo[sql]" jupyter pandas matplotlib ) \
        || echo "ws: could not install marimo/jupyter/pandas/matplotlib (offline?); run 'uv add marimo' later" >&2
      # let the editor's Python checker find the project's packages in .venv
      printf '\n[tool.pyright]\nvenvPath = "."\nvenv = ".venv"\n' >>"$dir/pyproject.toml"
      # marimo: run notebooks when they open, and rerun what changed when the file
      # changes on disk (for example when the agent edits it)
      printf '\n[tool.marimo.runtime]\nauto_instantiate = true\nwatcher_on_save = "autorun"\n' >>"$dir/pyproject.toml"
      mkdir -p "$dir/data" "$dir/analysis" "$dir/paper/figures" "$dir/paper/tables"
      touch "$dir/paper/figures/.gitkeep" "$dir/paper/tables/.gitkeep"
      cat >"$dir/README.md" <<EOF
# $title

    src/$pkg/   the software (import $pkg from the analysis)
    data/       input and generated data
    analysis/   marimo notebooks (.py) that produce the results
    paper/      the paper (Quarto, PDF through Typst)

Figures and tables made in analysis/ are saved to paper/figures/ and
paper/tables/, so re-running an analysis updates the paper.
EOF
      cat >"$dir/CLAUDE.md" <<'AGENTS'
# Notes for agents

- `src/` holds the software, `data/` the data, `analysis/` the marimo notebooks
  and `paper/` the Quarto paper. Figures and tables made in the notebooks are
  saved to `paper/figures/` and `paper/tables/`.
- The notebooks in `analysis/` are usually open in a live marimo window, which
  reruns cells when the file changes and may rewrite the file in its own format
  (for example a cell's `return` line). Read the file again just before you edit
  it, use edits that fail if the text is not found, and check afterwards that
  your change is in the file (`uv run marimo check analysis/<notebook>.py`).
- Run a whole notebook with `uv run analysis/<notebook>.py`.
- Never put passwords or keys in the code: they go in `.env`, which Git ignores
  and marimo loads.
AGENTS
      cat >"$dir/data/README.md" <<'EOF'
# Data

Put input data here and write generated data here. Git keeps everything in this
folder; add very large files (over about 50 MB) to .gitignore and note here where
they come from.
EOF
      cat >"$dir/analysis/01-explore.py" <<NOTEBOOK
import marimo

app = marimo.App(width="medium")


@app.cell(hide_code=True)
def _(mo):
    mo.md(
        """
        # Explore

        A marimo notebook. When you change a cell, every cell that depends on
        it runs again. To run the whole notebook from a terminal:
        \`uv run analysis/01-explore.py\`
        """
    )
    return


@app.cell
def _():
    import marimo as mo
    import matplotlib.pyplot as plt
    import pandas as pd

    import $pkg

    ROOT = mo.notebook_dir().parent
    DATA = ROOT / "data"
    FIGURES = ROOT / "paper" / "figures"
    return FIGURES, mo, pd, plt


@app.cell
def _(pd):
    example = pd.DataFrame({"year": [2020, 2021, 2022, 2023], "value": [1, 3, 2, 5]})
    example
    return (example,)


@app.cell(hide_code=True)
def _(mo):
    mo.md(
        """
        ## Ask the data in SQL

        SQL cells can query the tables above, files in data/ (for example
        FROM 'data/survey.csv') or a database: choose Add database connection
        in the panel on the left. Keep passwords in a .env file next to
        pyproject.toml; Git ignores it, and marimo reads it.
        """
    )
    return


@app.cell
def _(example, mo):
    recent = mo.sql(
        f"""
        SELECT year, value FROM example WHERE year >= 2022
        """
    )
    return (recent,)


@app.cell(hide_code=True)
def _(mo):
    mo.md(
        """
        ## A first figure

        Saved into paper/figures/, so the paper shows the latest version.
        """
    )
    return


@app.cell
def _(FIGURES, example, plt):
    fig, ax = plt.subplots(figsize=(6, 3.5))
    ax.plot(example.year, example.value, marker="o")
    ax.set_xlabel("Year")
    ax.set_ylabel("Value")
    fig.savefig(FIGURES / "example.pdf", bbox_inches="tight", metadata={"CreationDate": None})
    fig
    return


if __name__ == "__main__":
    app.run()
NOTEBOOK
      cat >"$dir/paper/_quarto.yml" <<'EOF'
project:
  output-dir: _output

bibliography: references.bib

format:
  typst:
    papersize: a4
    section-numbering: "1.1"
    citeproc: true
    keep-typ: true   # Neovim's click-to-source preview reads index.typ
EOF
      cat >"$dir/paper/index.qmd" <<EOF
---
title: "$title"
author: "$author"
date: today
abstract: |
  One paragraph: the question, the data, the method and the main finding.
---

# Introduction {#sec-introduction}

Start writing here. Keep one paragraph per line.

# Data and Methods {#sec-methods}

# Results {#sec-results}

<!-- After running analysis/01-explore.py:
![An example figure.](figures/example.pdf){#fig-example}
-->

# Discussion {#sec-discussion}

# References {.unnumbered}

::: {#refs}
:::
EOF
      : >"$dir/paper/references.bib"
      printf '.env\n.venv/\n__pycache__/\n__marimo__/\n.quarto/\n*_files/\n_output/\npaper/index.typ\npaper/index.pdf\nanalysis/*.html\n' >"$dir/.gitignore"
      ;;
    writing)
      mkdir -p "$dir/chapters"
      cat >"$dir/_quarto.yml" <<EOF
project:
  type: book
  output-dir: _output

book:
  title: "$title"
  author: "$author"
  date: today
  chapters:
    - index.qmd
    - chapters/01-introduction.qmd
    - references.qmd

bibliography: references.bib

format:
  typst:
    papersize: a4
    citeproc: true
    keep-typ: true   # Neovim's click-to-source preview (right-click > Show thesis preview) reads index.typ
EOF
      printf '# Preface {.unnumbered}\n\nWhat this is about, in a paragraph.\n' >"$dir/index.qmd"
      printf '# Introduction {#sec-introduction}\n\nStart writing here. Keep one paragraph per line.\n' >"$dir/chapters/01-introduction.qmd"
      printf '# References {.unnumbered}\n\n::: {#refs}\n:::\n' >"$dir/references.qmd"
      : >"$dir/references.bib"
      printf '_output/\n.quarto/\n*_files/\nindex.typ\nindex.pdf\n' >"$dir/.gitignore"
      ;;
    analysis)
      ( cd "$dir" && uv init -q --bare --name "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" ) || fail "uv init failed"
      ( cd "$dir" && uv add -q jupyter pandas matplotlib ) \
        || echo "ws: could not install jupyter/pandas/matplotlib (offline?); run 'uv add jupyter' later" >&2
      cat >"$dir/analysis.qmd" <<EOF
---
title: "$title"
author: "$author"
format: html
jupyter: python3
---

## Data

\`\`\`{python}
import pandas as pd
\`\`\`
EOF
      mkdir -p "$dir/data"
      printf '.venv/\n__pycache__/\n.quarto/\n*_files/\n_output/\nanalysis.html\n' >"$dir/.gitignore"
      ;;
    dev)
      printf '# %s\n' "$title" >"$dir/README.md"
      ;;
  esac
  git -C "$dir" init -q
  "$(realpath "$0")" --menu >/dev/null
  layout=""   # detect from the files just created
  # fall through: open the new project like any other
fi

dir="$(realpath "${dir:-$PWD}")"
[[ -d "$dir" ]] || fail "no such folder: $dir"
label="${label:-$(basename "$dir")}"

# ---- ws --notebook: the project's marimo notebooks, in a window of their own ----
# Runs in the analysis tab. It serves analysis/ on this computer only (with a secret
# token in the link) and waits: Enter opens the notebook window, like the PDF
# preview; Ctrl+C stops the server. The link is kept for --open-notebook.
NB_STATE="${XDG_RUNTIME_DIR:-/tmp}/ws-notebooks"
nb_key() { printf '%s' "$dir" | md5sum | cut -c1-12; }
nb_open() {   # nb_open <url>
  { omarchy-launch-webapp "$1" || xdg-open "$1"; } >/dev/null 2>&1 &
}
if [[ -n "$open_notebook" ]]; then
  url=$(cat "$NB_STATE/$(nb_key)" 2>/dev/null) && curl -s -o /dev/null "${url%%\?*}" \
    || { notify-send "Notebook" "The notebook isn't running: open the project's analysis tab and press Enter there." 2>/dev/null
         echo "ws: no notebook running for $dir (start it in the analysis tab)" >&2; exit 1; }
  if [[ -n "$nbfile" ]]; then
    rel=$(realpath --relative-to="$dir/analysis" "$nbfile" 2>/dev/null || true)
    [[ "$rel" == *.py && "$rel" != ../* ]] && url="${url%%&file=*}&file=$rel"
  fi
  nb_open "$url"
  exit 0
fi
if [[ -n "$notebook" ]]; then
  command -v uv >/dev/null || fail "notebooks need uv (run the installer again)"
  mkdir -p "$dir/analysis" "$NB_STATE"
  port=2718
  while ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; do port=$((port + 1)); done
  token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  first=$(grep -l '^import marimo' "$dir"/analysis/*.py 2>/dev/null | sort | head -1 || true)
  url="http://127.0.0.1:$port/?access_token=$token${first:+&file=$(basename "$first")}"
  log="$NB_STATE/$(nb_key).log"
  if [[ -f "$dir/pyproject.toml" ]]; then
    marimo=(uv run --project "$dir" --with "marimo[sql]" marimo)   # the project's packages, plus marimo
  else
    marimo=(uvx --from "marimo[sql]" --with pandas --with matplotlib marimo)
  fi
  echo "Starting the notebooks (the first time takes a minute)..."
  ( cd "$dir" && exec "${marimo[@]}" edit analysis --headless --watch --port "$port" --token-password "$token" ) >"$log" 2>&1 &
  server=$!
  trap 'kill "$server" 2>/dev/null; rm -f "$NB_STATE/$(nb_key)"' EXIT
  trap 'exit 130' INT HUP TERM   # Ctrl+C or the tab closing: run the cleanup above
  until curl -s -o /dev/null "http://127.0.0.1:$port/"; do
    kill -0 "$server" 2>/dev/null || { echo "The notebooks stopped:"; tail -n 20 "$log"; exit 1; }
    sleep 0.5
  done
  printf '%s\n' "$url" >"$NB_STATE/$(nb_key)"
  nb_message() {   # wrapped between words to fit the pane; redrawn when the pane is resized
    local cols
    cols=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2 || true)
    clear
    { echo "The notebooks for $label are ready."
      echo
      echo "Press Enter to open the notebook window, or right-click in the editor and choose Open the analysis notebook."
      echo
      echo "Each notebook is a .py file in analysis/. When you or the agent change one, the open window updates."
      echo
      echo "Ctrl+C stops the notebooks."
    } | fold -s -w "$(( ${cols:-80} - 1 ))"
  }
  nb_message
  trap nb_message WINCH
  while kill -0 "$server" 2>/dev/null; do
    if read -r -t 2 _; then nb_open "$url"
    elif (( $? <= 128 )); then sleep 2; fi   # no keyboard (input closed): just keep serving
  done
  echo "The notebooks stopped:"; tail -n 20 "$log"
  exit 1
fi

if [[ -z "$layout" ]]; then
  if [[ -f "$dir/paper/_quarto.yml" ]]; then
    layout=research
  elif [[ -f "$dir/_quarto.yml" ]] && grep -qE '^\s*(type:\s*(book|manuscript)|chapters:)' "$dir/_quarto.yml"; then
    layout=writing
  elif compgen -G "$dir/package.json" >/dev/null || compgen -G "$dir/Dockerfile" >/dev/null \
    || compgen -G "$dir/*compose*.y*ml" >/dev/null || compgen -G "$dir/go.mod" >/dev/null \
    || compgen -G "$dir/Cargo.toml" >/dev/null; then
    layout=dev
  elif compgen -G "$dir/pyproject.toml" >/dev/null || compgen -G "$dir/renv.lock" >/dev/null \
    || [[ -n "$(find "$dir" -maxdepth 3 \( -name '*.ipynb' -o -name '*.R' -o -name '*.qmd' \) -not -path '*/.*' -print -quit)" ]]; then
    layout=analysis
  else
    layout=dev
  fi
fi
case "$layout" in research|writing|analysis|dev) ;; *) fail "unknown layout '$layout'" ;; esac
[[ -n "$detect" ]] && { echo "$label: $layout"; exit 0; }

# ---- the programs each tab runs (used to build a workspace and to restart them) ----
REVIEW_CMD="hunk diff --watch --wrap --agent-notes"

# Writing: a Typst book previews in Neovim's click-to-source window (\qv), so
# quarto only re-renders on save and does not open a browser.
writing_build_cmd() {
  if grep -qE '^\s*typst:' "$dir/_quarto.yml"; then
    echo "quarto preview --to typst --no-browser"
  else
    echo "quarto preview"
  fi
}

analysis_console_cmd() {
  if [[ -f "$dir/pyproject.toml" ]] && command -v uv >/dev/null; then
    echo "uv run --with ipython ipython"
  elif compgen -G "$dir/*.R" >/dev/null || [[ -f "$dir/renv.lock" ]]; then
    echo "R"
  else
    echo "python3"
  fi
}

analysis_preview_cmd() {   # empty when the project has nothing to preview
  local qdir qfile qrun target=""
  # preview the Quarto project (often in a subfolder such as paper/), or else a single .qmd
  qdir=$(find "$dir" -maxdepth 2 -name _quarto.yml -not -path '*/.*' -printf '%h\n' | sort | head -1)
  qfile=$(find "$dir" -maxdepth 3 -name '*.qmd' -not -path '*/.*' -print | sort | head -1)
  # code cells must run in the project's environment, not the system Python
  qrun="quarto"
  [[ -f "$dir/pyproject.toml" ]] && command -v uv >/dev/null && qrun="uv run --project $(printf %q "$dir") quarto"
  if [[ -n "$qdir" ]]; then
    # a plain Quarto project previews as a whole only with an index page or a
    # book/website/manuscript type; otherwise preview its main .qmd file
    if ! compgen -G "$qdir/index.*" >/dev/null && ! grep -qE '^\s*type:\s*(book|website|manuscript)' "$qdir/_quarto.yml"; then
      target=$(find "$qdir" -maxdepth 1 -name '*.qmd' -printf '%f\n' | sort | head -1)
    fi
    echo "cd $(printf %q "$qdir") && $qrun preview $target"
  elif [[ -n "$qfile" ]]; then
    echo "$qrun preview $(printf %q "$qfile")"
  fi
}

# Research: the paper lives in paper/ and may run the project's Python, so
# quarto runs inside the project environment.
notebook_cmd() { echo "$(printf %q "$(realpath "$0")") --notebook $(printf %q "$dir")"; }

research_paper_cmd() {
  local qrun="quarto"
  [[ -f "$dir/pyproject.toml" ]] && command -v uv >/dev/null && qrun="uv run --project $(printf %q "$dir") quarto"
  echo "cd $(printf %q "$dir/paper") && $qrun preview --to typst --no-browser"
}

# After a reboot Herdr restores a workspace's tabs, panes and Claude sessions,
# but not the other programs. Start those again in panes that are back at a
# bare shell; anything still running is left alone.
revive() {   # revive <workspace id>
  local tabs panes pane pane_id agent first_in_tab tab_id pane_label tab_label cmd info seen_tabs=" " started=0
  tabs=$(herdr tab list | jq -c --arg w "$1" '[.result.tabs[] | select(.workspace_id == $w) | {(.tab_id): .label}] | add // {}')
  panes=$(herdr pane list | jq -c --arg w "$1" '.result.panes[] | select(.workspace_id == $w) | [.pane_id, .tab_id, (.label // ""), (.agent // "")]')
  while IFS= read -r pane; do
    [[ -z "$pane" ]] && continue
    IFS=$'\t' read -r pane_id tab_id pane_label agent < <(jq -r '@tsv' <<<"$pane")
    tab_label=$(jq -r --arg t "$tab_id" '.[$t] // ""' <<<"$tabs")
    first_in_tab=""; [[ "$seen_tabs" != *" $tab_id "* ]] && first_in_tab=1 && seen_tabs+="$tab_id "
    [[ -n "$agent" ]] && continue                                   # Claude: Herdr resumes it
    cmd=""
    if [[ "$pane_label" == editor ]]; then cmd="nvim"
    else
      case "$layout:$tab_label" in
        *:review)          cmd="$REVIEW_CMD" ;;
        dev:git)           cmd="lazygit" ;;
        writing:build)     cmd=$(writing_build_cmd) ;;
        analysis:preview)  cmd=$(analysis_preview_cmd) ;;
        analysis:console)  [[ -n "$first_in_tab" ]] && cmd=$(analysis_console_cmd) ;;
        research:analysis|research:run)   # "run" in workspaces made before v1.2; left pane is a plain shell
                           [[ -z "$first_in_tab" ]] && cmd=$(notebook_cmd) ;;
        research:paper)    cmd=$(research_paper_cmd) ;;
        research:git)      cmd="lazygit" ;;
      esac
    fi
    [[ -z "$cmd" ]] && continue
    info=$(herdr pane process-info --pane "$pane_id")
    if jq -e '.result.process_info | .foreground_process_group_id == .shell_pid' <<<"$info" >/dev/null; then
      herdr pane run "$pane_id" "$cmd" >/dev/null
      echo "  restarted in $tab_label: $cmd"
      started=$((started + 1))
    fi
  done <<<"$panes"
  [[ -n "$gui" && $started -gt 0 ]] && notify-send "Workspace" "$label: restarted $started program(s)" 2>/dev/null
  return 0
}

# Bring a Herdr window forward (its title is "<host>: <workspace>"), or open one.
show_window() {
  local addr
  addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg h "$(hostname): " \
    '[.[] | select(.title | startswith($h))] | sort_by(.focusHistoryID) | .[0].address // empty')
  if [[ -n "$addr" ]]; then
    hyprctl dispatch focuswindow "address:$addr" >/dev/null
  else
    setsid uwsm-app -- xdg-terminal-exec herdr >/dev/null 2>&1 &
  fi
}

if ! herdr workspace list >/dev/null 2>&1; then
  [[ -n "$gui" ]] || fail "Herdr is not running. Open a terminal and run: herdr"
  setsid uwsm-app -- xdg-terminal-exec herdr >/dev/null 2>&1 &
  for _ in $(seq 40); do herdr workspace list >/dev/null 2>&1 && break; sleep 0.25; done
  herdr workspace list >/dev/null 2>&1 || fail "Herdr did not start"
fi

existing=$(herdr workspace list | jq -r --arg l "$label" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
if [[ -n "$existing" ]]; then
  revive "$existing"
  herdr workspace focus "$existing" >/dev/null
  [[ -n "$gui" ]] && show_window
  echo "Focused existing workspace '$label' ($existing)."
  exit 0
fi

# ---- helpers ------------------------------------------------------------------
json() { jq -r "$1"; }
is_git() { git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; }
new_tab() {   # new_tab <label> -> root pane id
  herdr tab create --workspace "$wid" --cwd "$dir" --label "$1" --no-focus | json '.result.root_pane.pane_id'
}
split_right() {   # split_right <pane> <ratio> -> new pane id
  herdr pane split "$1" --direction right --ratio "$2" --cwd "$dir" --no-focus | json '.result.pane.pane_id'
}
run() { herdr pane run "$1" "$2" >/dev/null; }
review_tab() {
  if is_git; then
    run "$(new_tab review)" "$REVIEW_CMD"
  fi
}
editor_and_agent() {   # first tab: LazyVim (left) | Claude (right)
  local ws editor agent
  ws=$(herdr workspace create --cwd "$dir" --label "$label" --no-focus)
  wid=$(json '.result.workspace.workspace_id' <<<"$ws")
  editor=$(json '.result.root_pane.pane_id' <<<"$ws")
  herdr tab rename "$(json '.result.tab.tab_id' <<<"$ws")" "$1" >/dev/null
  agent=$(split_right "$editor" 0.55)
  herdr pane rename "$editor" editor >/dev/null
  run "$editor" nvim
  # The first time in a folder, Claude asks whether to trust it: that answer is yours.
  # Herdr agent names: lowercase letter first, then [a-z0-9_-], at most 32 characters
  local name
  name=$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | sed 's/^[^a-z]*//' | cut -c1-26)
  name="${name:-project}-agent"
  herdr agent start "$name" --kind claude --pane "$agent" >/dev/null 2>&1 \
    || echo "Claude is waiting for input in the agent pane (first time here: the folder-trust prompt)."
}

# ---- layouts ------------------------------------------------------------------
case "$layout" in
  research)
    if [[ -f "$dir/pyproject.toml" ]] && command -v uv >/dev/null; then
      echo "Preparing the Python environment (uv sync)..."
      uv sync -q --project "$dir" || echo "uv sync failed; the console may need attention" >&2
    fi
    editor_and_agent work
    runp=$(new_tab analysis)                                      # left: shell for running the software
    run "$(split_right "$runp" 0.5)" "$(notebook_cmd)"           # right: the marimo notebooks
    run "$(new_tab paper)" "$(research_paper_cmd)"
    review_tab
    if is_git; then run "$(new_tab git)" lazygit; fi
    ;;

  writing)
    editor_and_agent write
    review_tab
    run "$(new_tab build)" "$(writing_build_cmd)"
    ;;

  analysis)
    # create the project environment once, before the console and preview tabs both
    # call `uv run` and race to create it
    if [[ -f "$dir/pyproject.toml" ]] && command -v uv >/dev/null; then
      echo "Preparing the Python environment (uv sync)..."
      uv sync -q --project "$dir" || echo "uv sync failed; the console may need attention" >&2
    fi
    editor_and_agent work
    console=$(new_tab console)
    run "$console" "$(analysis_console_cmd)"
    sql=$(split_right "$console" 0.6)
    run "$sql" "duckdb${DATA_DB:+ $DATA_DB}"
    preview_cmd=$(analysis_preview_cmd)
    [[ -n "$preview_cmd" ]] && run "$(new_tab preview)" "$preview_cmd"
    review_tab
    ;;

  dev)
    editor_and_agent code
    runp=$(new_tab run)
    if [[ -f "$dir/package.json" ]]; then
      run "$runp" "npm run"        # lists the project's scripts; start one when you need it
    fi
    if is_git; then run "$(new_tab git)" lazygit; fi
    review_tab
    infra=$(new_tab infra)
    if docker info >/dev/null 2>&1 && { compgen -G "$dir/Dockerfile" >/dev/null || compgen -G "$dir/*compose*.y*ml" >/dev/null; }; then
      run "$infra" lazydocker
    fi
    ;;
esac

herdr workspace focus "$wid" >/dev/null
[[ -n "$gui" ]] && show_window
echo "Created workspace '$label' ($wid), layout: $layout."
